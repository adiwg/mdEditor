<div class='row'>

  <div
    class='col-sm-{{if this.model.files "9" "12"}}
      col-xxl-{{if this.model.files "10" "12"}}'
  >

    <h3 class='text-info'>Import Data</h3>
    {{#if this.model.preview}}
      <h3>{{capitalize (singularize this.model.preview.model.type)}}:
        {{this.model.preview.model.id}}</h3>
      {{control/md-json-viewer
        class='md-import-preview'
        json=this.model.preview.json
        modal=false
      }}
    {{else}}
      {{#unless this.model.files}}
        <FilePicker
          class='md-file-picker md-import-picker import-file-picker'
          @fileLoaded={{this.onFileLoaded}}
          @preview={{false}}
          @accept='.json,.xml'
          @readAs='readAsText'
        >
          <button type='button' class='btn btn-lg btn-info btn-block'>
            <p>{{fa-icon 'bullseye'}}
              Click or Drop a file here to import data.</p>
            <hr />
            {{#if this.isTranslating}}
              {{fa-icon 'spinner' spin=true}}
              Translating to mdJSON. Please wait...
              <br />
              {{!-- <small>Using <a href={{apiURL}}>{{apiURL}}</a> for translation.</small> --}}
            {{else}}
              <div class='inline-block text-left small'>
                These file formats are supported:
                <br />
                <ul>
                  <li>mdEditor (.json)</li>
                  <li>mdJSON (.json)</li>
                  <li>FGDC CSDGM (.xml)</li>
                </ul>
              </div>
            {{/if}}
          </button>
        </FilePicker>
        <hr />
        <h3>Import mdJSON from Online URL</h3>
        <div class='row'>
          <div class='col-xxl-6'>
            <div class='input-group input-group-lg'>
              <label class='sr-only' for='import-uri'>Import mdJSON URL</label>
              <input
                id='import-uri'
                type='url'
                value={{this.importUri}}
                placeholder='Enter online link to mdJSON'
                class='form-control'
                {{on 'input' this.setImportUri}}
              />
              <span class='input-group-btn'>
                <button
                  class='btn btn-primary'
                  type='button'
                  {{on 'click' this.readFromUri}}
                >
                  {{#if this.isLoading}}
                    {{fa-icon 'spinner' spin=true}}
                  {{else}}
                    {{fa-icon 'cloud-download'}}
                  {{/if}}
                  Import</button>
              </span>
            </div>
          </div>
        </div>
      {{/unless}}
      {{#each-in this.model.files as |key item|}}
        <div
          class='md-table-block md-table-checkbox box-shadow--2dp'
          data-spy={{capitalize key}}
        >
          <h3 class='text-info'>{{capitalize key}}</h3>
          <div class='table-responsive'>
            <table class='table table-striped table-hover'>
              <thead>
                <tr>
                  <th></th>
                  <th>Id</th>
                  <th>Title</th>
                  <th>Last Updated</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {{#each item as |row|}}
                  <tr>
                    <td>
                      <input
                        type='checkbox'
                        checked={{row.meta.export}}
                        aria-label='Include in import'
                        {{on 'change' (fn this.toggleRowExport row)}}
                      />
                    </td>
                    <td>{{row.id}}</td>
                    <td>{{row.meta.title}}</td>
                    <td>{{row.dateUpdated}}</td>
                    <td>
                      <div class='pull-right'>
                        <button
                          type='button'
                          class='btn btn-xs btn-primary'
                          {{on 'click' (fn this.showPreview row)}}
                        >
                          <span class='fa fa-binoculars'></span>
                          Preview JSON
                        </button>
                      </div>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>
      {{/each-in}}
    {{/if}}
  </div>

  {{#if this.model.files}}
    <div class='md-control-sidebar col-sm-3 col-xxl-2 no-nav'>
      {{#if this.model.preview}}
        <button
          type='button'
          class='btn btn-lg btn-primary btn-block md-btn-responsive'
          {{on 'click' this.closePreview}}
        >{{fa-icon 'arrow-left'}} Close Preview</button>
      {{else if this.model.files}}
        <button
          type='button'
          class='btn btn-lg btn-success btn-block md-btn-responsive'
          {{on 'click' this.importData}}
        >{{fa-icon 'sign-in'}} Click to Import Data</button>
        <button
          type='button'
          class='btn btn-lg btn-danger btn-block md-btn-responsive'
          {{on 'click' this.cancelImport}}
        >{{fa-icon 'times'}} Cancel Import</button>
        <div class='btn-fake btn-block'>
          {{x-toggle
            value=this.model.merge
            onToggle=this.toggleMerge
            showLabels=true
            onLabel='Merge'
            offLabel='Replace'
            size='medium'
            theme='default'
          }}
        </div>
        <hr />
        {{control/md-scroll-spy
          offset=130
          scrollInit=this.scrollTo
          setScrollTo=this.setScrollTo
        }}
      {{/if}}
    </div>
  {{/if}}

</div>
{{outlet}}

<Control::MdModal
  @isShowing={{this.showApiModal}}
  @showConfirm={{true}}
  @confirmLabel='Go to Settings'
  @showCancel={{true}}
  @confirm={{this.goToSettings}}
  @cancel={{fn (mut this.showApiModal) false}}
>
  <div class='alert alert-info' role='alert'>{{fa-icon 'exclamation-triangle'}}
    mdTranslator API URL required.
  </div>
  <p>
    Please go to
    <LinkTo @route='settings'>Settings > Main</LinkTo>
    and configure the mdTranslator API URL before importing.
  </p>
</Control::MdModal>