<h4 class='section-header'>
  Editing Extents
  {{control/md-status model=this.model}}
</h4>

<section>
  {{#each this.model.json.metadata.resourceInfo.extent as |extent index|}}
    {{object/md-extent
      title='Extent'
      extent=extent
      index=index
      profilePath='record.extent'
      deleteExtent=this.deleteExtent
      editFeatures=this.editFeatures
      addExtent=this.addExtent
    }}
  {{else}}
    <h3 class='alert alert-info'>No Extents found.
      <button
        type='button'
        class='btn btn-lg btn-success'
        {{on 'click' this.addExtent}}
      >
        {{fa-icon 'plus'}}
        Add Extent</button>
    </h3>
  {{/each}}
</section>

{{to-elsewhere
  named='md-subbar-extra'
  send=(component
    'control/md-button'
    text='Add Extent'
    icon='plus'
    class='btn-lg btn-success'
    onClick=this.addExtent
  )
}}

{{to-elsewhere
  named='md-scroll-spy-record-edit'
  send=(component
    'control/md-scroll-spy'
    refresh=this.refreshSpy
    scrollInit=this.scrollTo
    setScrollTo=this.setScrollTo
  )
}}