<h4 class='section-header'>
  Editing Taxonomy Collection #{{this.collectionId}}
  {{control/md-status model=this.parentModel}}
</h4>

{{object/md-taxonomy/collection
  model=this.model
  id=this.collectionId
  profilePath='record.taxonomy.collection'
  editSystem=this.editSystem
}}

{{to-elsewhere
  named='md-subbar-buttons'
  send=(component
    'control/md-button'
    text='Add New Taxa'
    icon='plus'
    class='btn-info btn-lg'
    click=this.addTaxa
  )
}}
{{to-elsewhere
  named='md-subbar-buttons'
  send=(component
    'control/md-button'
    text='Add Taxa from ITIS'
    icon='plus'
    class='btn-success btn-lg'
    click=this.addITIS
  )
}}
{{to-elsewhere
  named='md-subbar-buttons'
  send=(component
    'control/md-button'
    text='Back to List'
    icon='arrow-left'
    class='btn-primary btn-lg'
    click=this.toList
  )
}}

{{to-elsewhere
  named='md-scroll-spy-record-edit'
  send=(component
    'control/md-scroll-spy'
    scrollInit=this.scrollTo
    setScrollTo=this.setScrollTo
  )
}}

<Control::MdModal
  @isShowing={{this.showItisModal}}
  @showConfirm={{true}}
  @confirmLabel='Go to Settings'
  @showCancel={{true}}
  @confirmAction={{this.goToSettings}}
  @cancel={{this.hideItisModal}}
>
  <div class='alert alert-info' role='alert'>{{fa-icon 'exclamation-triangle'}}
    ITIS Proxy URL is required.
  </div>
  <p>
    Please go to
    <LinkTo @route='settings'>Settings > Main</LinkTo>
    and configure the ITIS Proxy URL to add taxonomy from ITIS.
  </p>
</Control::MdModal>