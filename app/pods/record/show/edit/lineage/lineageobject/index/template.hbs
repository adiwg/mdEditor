<h4 class='section-header'>
  Editing Lineage #{{lineageId}}
  {{control/md-status model=parentModel}}
</h4>

{{object/md-lineage
  model=model
  profilePath='record.lineage'
  ellipsis=true
  editCitation=this.editCitation
  editProcessStep=this.editProcessStep
  editSource=this.editSource
}}

{{to-elsewhere
  named='md-subbar-extra'
  send=(component
    'control/subbar-link'
    text='Back to Lineage List'
    icon='arrow-left'
    route='record.show.edit.lineage'
  )
}}
{{to-elsewhere
  named='md-scroll-spy-record-edit'
  send=(component
    'control/md-scroll-spy'
    scrollInit=scrollTo
    setScrollTo=this.setScrollTo
  )
}}