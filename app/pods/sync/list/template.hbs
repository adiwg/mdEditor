<div class='row'>
  <div class='col-sm-10'>
    <h3 class='text-info'>Sync Data</h3>
    {{#each this.model as |section index|}}
      {{#if section.length}}
        {{#if index}}
          <hr />
        {{/if}}

        <Layout::MdCard
          @title={{section.meta.pouchTitle}}
          @titleIcon={{section.meta.icon}}
          @collapsible={{true}}
          @collapsed={{false}}
          @data-spy={{section.meta.title}}
          @shadow={{true}}
        >

          <Control::MdPouchRecordTable
            @data={{section}}
            @dataColumns={{section.meta.columns}}
          />
        </Layout::MdCard>
      {{else}}
        <div class='alert alert-info'>
          <h3>{{fa-icon section.meta.icon}}
            No
            <em>{{section.meta.title}}</em>
            found.</h3>
        </div>
      {{/if}}

      <Control::MdPouchAdd @section={{section}} />

    {{/each}}
  </div>

  <div class='md-control-sidebar col-sm-2 no-nav'>
    <Control::MdCouchLogin />
  </div>
</div>