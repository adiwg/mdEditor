<button
  type='button'
  {{on 'click' this.doToggleAllSelection}}
  class='center-block md-checkbox-all'
  aria-label='Toggle all rows'
>
  <i
    class={{if
      (is-equal this.selectedItems.length this.data.length)
      this.themeInstance.selectAllRowsIcon
      this.themeInstance.deselectAllRowsIcon
    }}
  ></i>
</button>