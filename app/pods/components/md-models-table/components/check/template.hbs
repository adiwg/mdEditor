<button
  type='button'
  {{on 'click' this.doClickOnRow}}
  class='md-checkbox-cell'
  aria-label='Toggle row selection'
  aria-pressed={{if @isSelected 'true' 'false'}}
>
  {{#if @isSelected}}
    {{fa-icon 'check-square-o' fw=true}}
  {{else}}
    {{fa-icon 'square-o' fw=true}}
  {{/if}}
</button>
