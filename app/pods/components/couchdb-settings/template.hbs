<div class='form'>
  {{input/md-input
    label='Publisher Endpoint'
    model=@model
    valuePath='publisherEndpoint'
    placeholder='Enter the CouchDB server URL (e.g., https://mycouch.example.com)'
    change=@save
  }}
  {{input/md-input
    label='CouchDB Database Name'
    model=@model
    valuePath='couchdb-database'
    placeholder='Enter the default database name'
    change=@save
  }}
  {{input/md-input
    label='Default Username'
    model=@model
    valuePath='couchdb-username'
    placeholder='Enter the default username (password will not be saved)'
    change=@save
  }}
  <div class='alert alert-info'>
    <strong>Note:</strong>
    Passwords are not saved in settings for security reasons. You will need to
    enter your password each time you connect.
  </div>
</div>