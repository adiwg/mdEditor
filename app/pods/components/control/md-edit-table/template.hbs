<Control::MdRecordTable
  class='md-edit-table'
  @actionsColumn={{this.actionsColumn}}
  @selectRowOnClick={{@selectRowOnClick}}
  @data={{@data}}
  @dataColumns={{@dataColumns}}
  @expandedItems={{@expandedItems}}
  @columnSets={{@columnSets}}
  @pageSize={{@pageSize}}
  @expandedRowComponent={{component
    'md-models-table/components/row-body'
    spotlighted=true
    rowBodyComponent=@rowBodyComponent
  }}
/>
