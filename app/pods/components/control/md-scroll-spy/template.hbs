{{#if this.setScrollTo}}
  <ul class='nav nav-pills nav-stacked'>
    {{#each this.links as |link|}}
      <li class={{if link.embedded 'md-embedded'}}>
        <a href='#{{link.id}}' {{on 'click' this.clickLink}}>
          {{link.text}}
        </a>
      </li>
    {{/each}}
    {{yield}}
  </ul>
{{/if}}