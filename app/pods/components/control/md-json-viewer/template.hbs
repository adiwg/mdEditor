{{#if this.modal}}
  <ModalDialog
    @onClose={{this.closeModal}}
    @translucentOverlay={{true}}
    @containerClass='md-jsmodal-container'
    @overlayClass='md-modal-overlay'
    @attachment='top center'
    @targetAttachment='top center'
    @tetherTarget='html'
  >
    <button
      type='button'
      {{on 'click' this.closeModal}}
      class='md-modal-close'
      aria-label='Close'
    >
      <span class='fa-stack'>
        <i class='fa fa-circle fa-stack-2x'></i>
        <i class='fa fa-times fa-stack-1x fa-inverse'></i>
      </span>
    </button>
    <div class='md-viewer-body'></div>
  </ModalDialog>
{{else}}
  <div class='well'>
    <div class='btn-toolbar md-viewer-controls pull-right'>
      <div
        class='btn-group-vertical'
        role='group'
        aria-label='JSON viewer controls'
      >
        <button
          type='button'
          class='btn btn-primary'
          {{on 'click' this.expand}}
          title='Expand All'
        >{{fa-icon 'plus'}}</button>
        <button
          type='button'
          class='btn btn-default'
          {{on 'click' this.collapse}}
          title='Collapse All'
        >{{fa-icon 'minus'}}</button>
      </div>
      <div
        class='btn-group-vertical'
        role='group'
        aria-label='JSON viewer controls'
      >
        <button
          type='button'
          class='btn btn-primary'
          {{on 'click' this.zoomin}}
          title='Zoom in'
        >{{fa-icon 'search'}}</button>
        <button
          type='button'
          class='btn btn-default'
          {{on 'click' this.zoomout}}
          title='Zoom Out'
        >{{fa-icon 'search-minus'}}</button>
      </div>
    </div>
    <div class='md-viewer-body'>
    </div>
  </div>
{{/if}}