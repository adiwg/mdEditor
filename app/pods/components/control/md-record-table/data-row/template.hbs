{{! template-lint-disable no-invalid-interactive }}
<tr
  class='{{this.rowSelectedClass}}'
  {{on 'click' this.onClick}}
  ...attributes
>
  {{#each this.cells as |cell|}}
    <td class='{{cell.column.className}}'>
      {{#if cell.isCheck}}
        <button
          type='button'
          class='md-checkbox-cell'
          aria-label='Toggle row selection'
          aria-pressed={{if this.isSelected 'true' 'false'}}
          {{on 'click' (fn this.toggleRowSelection cell.index)}}
        >
          {{#if this.isSelected}}
            {{fa-icon 'check-square-o' fw=true}}
          {{else}}
            {{fa-icon 'square-o' fw=true}}
          {{/if}}
        </button>
      {{else if cell.isCustomButton}}
        {{#if cell.buttonConfig}}
          <button
            type='button'
            class='btn btn-sm btn-{{if cell.buttonConfig.style cell.buttonConfig.style "primary"}}'
            {{on 'click' (fn this.runCustomButtonAction cell.buttonConfig)}}
          >
            {{fa-icon 'binoculars'}}
            {{cell.buttonConfig.title}}
          </button>
        {{/if}}
      {{else}}
        {{cell.value}}
      {{/if}}
    </td>
  {{/each}}
</tr>
