<hr />
<div
  class='btn-group-vertical center-block'
  role='group'
  aria-label='Geographic Extent Button Controls'
>
  <button
    type='button'
    class='btn btn-lg btn-success btn-block md-btn-responsive'
    {{on 'click' this.zoomAll}}
  >
    {{fa-icon 'search'}}
    Zoom All</button>
  <button
    type='button'
    class='btn btn-lg btn-warning btn-block md-btn-responsive'
    {{on 'click' this.uploadData}}
  >{{fa-icon 'upload'}} Import Features</button>
  <button
    type='button'
    class='btn btn-lg btn-info btn-block md-btn-responsive'
    {{on 'click' this.exportGeoJSON}}
  >{{fa-icon 'download'}} Export Features</button>
  <Control::MdButtonConfirm
    class='btn btn-lg btn-danger btn-block md-btn-responsive'
    @onConfirm={{this.deleteAllFeatures}}
  > {{fa-icon 'times'}} Delete All</Control::MdButtonConfirm>
</div>
<hr />
<button
  type='button'
  class='btn btn-lg btn-primary btn-block md-btn-responsive'
  {{on 'click' this.toList}}
>
  {{fa-icon 'list'}}
  Back to List
</button>
{{yield}}