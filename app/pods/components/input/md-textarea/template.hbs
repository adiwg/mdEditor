{{#if this.label}}
  {{#if this.isCollapsible}}
    <button
      type='button'
      class='btn btn-link btn-xs'
      {{on 'click' this.toggleExpanded}}
    >
      {{fa-icon (if this.isExpanded 'caret-up' 'caret-down')}}
      {{this.label}}
    </button>
  {{else}}
    <label for={{concat this.elementId '-textarea'}}>{{this.label}}</label>
  {{/if}}
  {{#if this.showInfotip}}
    {{control/md-infotip text=this.placeholder}}
  {{/if}}
{{/if}}

{{#if this.isExpanded}}
  <div class='md-input-input'>
    <label
      class='sr-only'
      for={{concat this.elementId '-textarea'}}
    >{{this.label}}</label>
    <textarea
      id={{concat this.elementId '-textarea'}}
      placeholder={{this.placeholder}}
      required={{this.required}}
      maxlength={{this.maxlength}}
      rows={{this.rows}}
      class={{this.inputClass}}
      readonly={{this.readonly}}
      disabled={{this.readonly}}
      {{on 'input' this.updateValue}}
      {{autoresize}}
    >{{this.value}}</textarea>
    <span class='md-input-error'>
      {{#if this.showErrorMessage}}
        <span class='md-error'>
          {{fa-icon 'exclamation-circle'}}
          <EmberTooltip
            @side='right'
            @tooltipClass='ember-tooltip md-tooltip danger'
          >
            {{v-get this.model this.valuePath 'message'}}
          </EmberTooltip>
        </span>
      {{/if}}

      {{#if this.showWarningMessage}}
        <span class='md-warning'>
          {{fa-icon 'exclamation-triangle'}}
          <EmberTooltip
            @side='right'
            @tooltipClass='ember-tooltip md-tooltip warning'
          >
            {{v-get this.model this.valuePath 'warningMessage'}}
          </EmberTooltip>
        </span>
      {{/if}}
    </span>
  </div>
  {{yield}}
{{/if}}