<Layout::MdCard
  @title='Basic Information'
  @collapsible={{true}}
  @collapsed={{false}}
  @profilePath='{{this.profilePath}}.basicInformation'
  @data-spy={{if this.data-spy 'Basic Information'}}
  @class={{if this.embedded 'md-embedded'}}
  @shadow={{if this.embedded false true}}
  @required={{true}}
>

  {{input/md-input
    model=this.model
    valuePath='title'
    placeholder='Enter the title for the resource.'
    label='Title'
    required=true
    profilePath=(concat this.profilePath '.basicInformation.title')
    data-spy=(if this.data-spy 'Title')
    class='md-embedded'
  }}

  <Layout::MdCard
    @shadow={{false}}
    @profilePath='{{this.profilePath}}.basicInformation.alternateTitle'
  >
    <Object::MdSimpleArrayTable
      @data-spy={{false}}
      @title='Alternate Title'
      @plain={{true}}
      @value={{this.model.alternateTitle}}
      as |alt|
    >
      <td>
        {{input/md-input
          model=alt.item
          valuePath='value'
          placeholder='Additional titles for the resource.'
        }}
      </td>
    </Object::MdSimpleArrayTable>
  </Layout::MdCard>

  <Layout::MdCard
    @shadow={{false}}
    @profilePath='{{this.profilePath}}.basicInformation.dates'
    @data-spy={{if this.data-spy 'Dates'}}
    @class='md-embedded'
  >
    {{object/md-date-array
      value=this.model.date
      plain=true
      data-spy=false
      profilePath=(concat this.profilePath '.basicInformation.dates')
    }}
  </Layout::MdCard>

  {{#unless this.embedded}}
    {{input/md-input
      value=this.model.edition
      placeholder='Enter the edition.'
      label='Edition'
      profilePath=(concat this.profilePath '.basicInformation.edition')
    }}

    {{input/md-codelist-multi
      value=this.model.presentationForm
      label='Presentation Form'
      create=true
      tooltip=true
      icon=false
      mdCodeName='presentationForm'
      closeOnSelect=false
      placeholder='Select or enter one or more forms.'
      profilePath=(concat this.profilePath '.basicInformation.presentationForm')
    }}
  {{/unless}}

</Layout::MdCard>

{{object/md-party-array
  title='Responsible Party'
  data-spy=(if this.data-spy 'Responsible Parties')
  class=(if this.embedded 'md-embedded')
  collapsible=true
  collapsed=false
  required=false
  value=this.model.responsibleParty
  profilePath=(concat this.profilePath '.responsibleParty')
}}

{{object/md-online-resource-array
  model=this.model.onlineResource
  profilePath=(concat this.profilePath '.onlineResource')
  class=(if this.embedded 'md-embedded')
  data-spy=(if this.data-spy 'Online Resource')
}}

{{object/md-identifier-array
  model=this.model.identifier
  profilePath=(concat this.profilePath '.identifier')
  data-spy=(if this.data-spy 'Identifier')
  editItem=this.editIdentifier
  class=(if this.embedded 'md-embedded')
  visibility=(if this.simpleIdentifier false true)
}}

{{object/md-identifier-object-table
  model=this.model.identifier
  profilePath=(concat this.profilePath '.identifierSimple')
  data-spy=(if this.data-spy 'Identifier')
  visibility=(if this.simpleIdentifier true false)
  short=this.shortIdentifier
  class=(if this.embedded 'md-embedded')
}}

{{object/md-identifier-object-table
  model=this.model.identifier
  profilePath=(concat this.profilePath '.identifierShort')
  data-spy=(if this.data-spy 'Identifier')
  visibility=false
  short=true
  class=(if this.embedded 'md-embedded')
}}

{{#unless this.embedded}}
  <Layout::MdCard
    @collapsible={{true}}
    @title='Series'
    @profilePath='{{this.profilePath}}.series'
    @data-spy={{if this.data-spy 'Series'}}
    @content={{this.model.series}}
  >
    {{input/md-input
      value=this.model.series.seriesName
      placeholder='Enter the name for the series.'
      label='Name'
      profilePath=(concat this.profilePath '.series.name')
    }}

    {{input/md-input
      value=this.model.series.seriesIssue
      placeholder='Enter the issue for the series.'
      label='Issue'
      profilePath=(concat this.profilePath '.series.issue')
    }}

    {{input/md-input
      value=this.model.series.issuePage
      placeholder='Enter the page(s) for the issue.'
      label='Page'
      profilePath=(concat this.profilePath '.series.page')
    }}
  </Layout::MdCard>

  <Object::MdSimpleArrayTable
    @title='Other Details'
    @required={{false}}
    @plain={{false}}
    @data-spy={{if this.data-spy 'Other Details'}}
    @profilePath='{{this.profilePath}}.otherCitationDetails'
    @value={{this.model.otherCitationDetails}}
    as |val|
  >
    <td>
      {{input/md-textarea
        model=val.item
        valuePath='value'
        placeholder='Enter additional detail about the citation.'
      }}
    </td>
  </Object::MdSimpleArrayTable>

  {{object/md-graphic-array
    model=this.model.graphic
    data-spy=(if this.data-spy 'Graphic')
    button-text='Add Graphic'
    label='Graphic'
    profilePath=(concat this.profilePath '.graphic')
  }}
{{/unless}}

{{yield}}