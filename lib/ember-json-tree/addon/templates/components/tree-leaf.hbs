{{#if this.inTree}}
  {{#unless this.model.isRoot}}
    <span class='tree-cell text-nowrap'>
      {{#each (range 1 this.nodeDepth)}}
        <span class='tree-indent'></span>
      {{/each}}
    </span>
  {{/unless}}

  <span
    class='tree-cell tree-icon'
    role='button'
    {{on 'click' this.toggleCheck}}
  >
    {{#if this.model.draggable}}
      {{fa-icon 'ellipsis-v' fixedWidth=false}}
    {{/if}}
  </span>

  {{#unless this.disableCheck}}
    {{#unless this.model.hideCheck}}
      <span
        class='tree-cell tree-icon'
        role='button'
        {{on 'click' this.toggleCheck}}
      >
        {{#if this.model.checkable}}
          {{fa-icon
            (if this.model.isChecked 'check-square-o' 'square-o')
            fixedWidth=true
          }}
        {{else}}
          <span class='icon fa fa-fw'></span>
        {{/if}}
      </span>
    {{/unless}}
  {{/unless}}

  {{#unless this.model.hideToggle}}
    <span class='tree-cell tree-icon'>
      <span class='toggle-icon' role='button' {{on 'click' this.toggleExpand}}>
        {{#if this.model.children.length}}
          {{fa-icon
            (if this.model.isExpanded 'minus' 'plus')
            fixedWidth=true
            class='icon expand-icon'
          }}
        {{else}}
          <span class='icon fa fa-fw'></span>
        {{/if}}
      </span>
    </span>
  {{/unless}}

  <span class='tree-cell tree-fill'>
    <span class='tree-cell'>
      {{tree-label
        model=this.model
        labelComponent=this.labelComponent
        nodePath=this.nodePath
        selected=this.selected
      }}
    </span>
  </span>
  {{#if this.model.definition}}
    <span class='tree-cell'>
      <span class='badge'>?
        {{ember-tooltip text=this.model.definition side='right'}}
      </span>
    </span>
  {{/if}}
  {{#if this.model._isDragTarget}}
    <span class='tree-cell'>
      <span class='tree-drop-indicator'>DROP TARGET</span>
    </span>
  {{/if}}
{{else}}
  {{tree-label
    labelComponent=this.labelComponent
    model=this.model
    nodePath=this.nodePath
    selected=this.selected
    highlight=this.highlight
  }}
{{/if}}