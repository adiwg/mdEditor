{{#nestable-draggable-object
  content=this
  isDraggable=this.model.draggable
  dragStartAction=this.dragStart
  dragMoveAction=this.dragMove
  dragEndAction=this.dragEnd
}}
  {{#tree-draggable-target
    action=this.handleDropAction
    model=this.model
    validateDragEvent=this.validateDragEvent
    validateDrag=this.validateDrag
    dragged=this.tree.dragged
    dragOverAction=this.dragOver
    dragOutAction=this.dragOut
  }}
    {{tree-leaf
      model=this.model
      inTree=true
      select=this.select
      selected=this.selected
      hover=this.hover
      nodeDepth=this.nodeDepth
      nodePath=this.nodePath
      disableCheck=this.disableCheck
      labelComponent=this.labelComponent
    }}
  {{/tree-draggable-target}}
{{/nestable-draggable-object}}

{{#if this.model.isExpanded}}
  {{tree-view
    model=this.model.children
    select=this.select
    selected=this.selected
    sortKeys=this.sortKeys
    hover=this.hover
    parentDepth=this.nodeDepth
    parentPath=this.nodePath
    disableCheck=this.disableCheck
    labelComponent=this.labelComponent
    tree=this.tree
    validateDrag=this.tree.validateDrag
    handleDrop=this.tree.handleDrop
  }}
{{/if}}