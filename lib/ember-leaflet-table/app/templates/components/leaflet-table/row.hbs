<tr class={{record.state}}>
  {{#each processedColumns as |column|}}
    {{#if column.isVisible}}
      <td class={{column.className}}>
        {{#if column.template}}
          {{#if (eq column.template 'components/leaflet-table/actions')}}
            {{leaflet-table/actions
              record=record
              showForm=showForm
              zoomTo=zoomTo
              deleteFeature=deleteFeature
            }}
          {{else}}
            {{component
              column.template
              record=record
              showForm=showForm
              zoomTo=zoomTo
              deleteFeature=deleteFeature
            }}
          {{/if}}
        {{else}}
          {{get record column.propertyName}}
        {{/if}}
      </td>
    {{/if}}
  {{/each}}
</tr>