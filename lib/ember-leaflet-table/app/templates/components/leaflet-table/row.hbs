<tr class={{this.record.state}}>
  {{#each this.processedColumns as |column|}}
    {{#if column.isVisible}}
      <td class={{column.className}}>
        {{#if column.template}}
          {{#if (eq column.template 'components/leaflet-table/actions')}}
            {{leaflet-table/actions
              record=this.record
              showForm=this.showForm
              zoomTo=this.zoomTo
              deleteFeature=this.deleteFeature
            }}
          {{else}}
            {{component
              column.template
              record=this.record
              showForm=this.showForm
              zoomTo=this.zoomTo
              deleteFeature=this.deleteFeature
            }}
          {{/if}}
        {{else}}
          {{get this.record column.propertyName}}
        {{/if}}
      </td>
    {{/if}}
  {{/each}}
</tr>