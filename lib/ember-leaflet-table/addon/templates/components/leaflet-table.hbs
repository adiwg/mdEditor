<FilePicker
  @class='map-file-picker'
  @fileLoaded='readData'
  @progressValue={{this.progress}}
  @selectOnClick={{false}}
  @preview={{false}}
  @accept={{this.fileTypes}}
  @readAs='readAsArrayBuffer'
>
  <div class='map-dropzone-target'>
    <span><i class='fa fa-bullseye'></i> Drop Here!</span>
  </div>
  <LeafletDraw
    @lat={{this.lat}}
    @lng={{this.lng}}
    @zoom={{this.zoom}}
    @onLoad={{action 'setup'}}
    @editLayers={{this.layers}}
    @closeForm={{action 'closeForm'}}
    @showForm={{action 'showForm'}}
  >
    {{! Specify child layer components here }}
    <LayerGroup @name='Terrain' @baselayer={{true}} @default={{true}}>

      {{! tile-layer url="http://{s}.tile.stamen.com/terrain/{z}/{x}/{y}.png" attribution=mapAttribution }}

      {{! tile-layer url="//stamen-tiles-{s}.a.ssl.fastly.net/terrain/{z}/{x}/{y}.png" attribution=mapAttribution }}

      {{tile-layer
        url='//tiles.stadiamaps.com/tiles/stamen_terrain/{z}/{x}/{y}.png'
        attribution=this.mapAttribution
      }}

    </LayerGroup>

    {{geojson-layer
      geoJSON=this.worldOverlay
      stroke=false
      color='#555555'
      fillOpacity=0.1
    }}

    <FeatureGroup
      @name='Extents'
      @default={{true}}
      @setFeatureGroup={{this.setFeatureGroup}}
    >
      {{#each this.layers as |l|}}
        {{lgeojson-layer geoJSON=l draw=true editLayers=this.layers}}
      {{/each}}
    </FeatureGroup>

    {{layer-control}}
  </LeafletDraw>

  {{#if this.formData}}
    <h4 class='table-title'>Edit Feature Properties
      <button
        class='btn btn-xs btn-info pull-right'
        {{on 'click' (action 'closeForm')}}
        title='Close Form'
        type='button'
      >
        <span class='fa fa-check'></span>
        OK
      </button>
    </h4>
    {{feature-form model=this.formData}}
  {{else}}
    <h4 class='table-title'>Feature Properties</h4>
    <FeatureTable
      @data={{this.layers}}
      @columnComponents={{hash
        leaflet-table-row-actions=(component
          'leaflet-table-row-actions'
          showForm=(action 'showForm')
          zoomTo=(action 'zoomTo')
          deleteFeature=(action 'deleteFeature')
        )
      }}
      @showGlobalFilter={{false}}
      @showColumnsDropdown={{false}}
      @pageSize={{10}}
      as |ft|
    >
      {{#ft.Table as |table|}}
        {{table.Header}}
        {{#table.Body as |body|}}
          {{#if body.allColumnsAreHidden}}
            {{body.ColumnsHidden}}
          {{else}}
            {{#if body.visibleContent.length}}
              {{#each body.visibleContent as |record index|}}
                {{body.row
                  record=record
                  index=index
                  showForm=(action 'showForm')
                  zoomTo=(action 'zoomTo')
                  deleteFeature=(action 'deleteFeature')
                }}
                {{#if (exists-in body.expandedItems record)}}
                  {{body.RowExpand
                    expandedRowComponent=this.expandedRowComponent
                    record=record
                    index=index
                  }}
                {{/if}}
              {{/each}}
            {{else}}
              {{body.no-data}}
            {{/if}}
          {{/if}}
        {{/table.Body}}
        {{table.Footer}}
      {{/ft.Table}}
      {{ft.Footer}}
    </FeatureTable>
  {{/if}}
  {{yield}}
</FilePicker>
