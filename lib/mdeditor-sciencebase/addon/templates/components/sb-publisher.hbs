<div class='row'>
  <div class='col-sm-9'>
    {{sb-tree
      labelComponent='sb-tree-label'
      model=model
      selected=selected
      select=(fn this.send 'selectRecord')
    }}
  </div>
  <div class='col-sm-3'>
    <div class='md-control-sidebar'>
      {{#if hasToken}}
        {{#if tokenService.token}}
          <div class='card'>
            <div class='card-block'>
              Token added for
              {{tokenService.userName}}
              Expires
              {{moment-format tokenService.expiry 'LLL'}}
            </div>
          </div>
          <hr />
        {{/if}}
        <button
          type='button'
          class='btn btn-lg btn-primary'
          disabled={{if canPublish false true}}
          {{on 'click' (fn this.send 'publish')}}
        >
          Publish
        </button>
      {{else}}
        {{input/md-input
          value=this.rawToken
          placeholder='Enter ScienceBase token'
        }}
        <button
          type='button'
          class='btn btn-lg btn-primary add-token-button'
          disabled={{if rawToken false true}}
          {{on 'click' (fn this.send 'addToken')}}
        >
          Add token
        </button>
      {{/if}}
    </div>
  </div>
</div>