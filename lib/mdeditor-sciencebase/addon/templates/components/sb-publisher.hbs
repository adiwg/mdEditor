<div class='row'>
  <div class='col-sm-9'>
    {{sb-tree
      labelComponent='sb-tree-label'
      model=this.model
      selected=this.selected
      select=this.selectRecord
      onDropComplete=this.onDropComplete
    }}
  </div>
  <div class='col-sm-3'>
    <div class='md-control-sidebar'>
      {{#if this.hasToken}}
        {{#if this.tokenService.token}}
          <div class='card'>
            <div class='card-block'>
              Token added for
              {{this.tokenService.userName}}
              Expires
              {{moment-format this.tokenService.expiry 'LLL'}}
            </div>
          </div>
          <hr />
        {{/if}}
        <button
          type='button'
          class='btn btn-lg btn-primary'
          disabled={{if this.canPublish false true}}
          {{on 'click' this.publish}}
        >
          Publish
        </button>
      {{else}}
        {{input/md-input
          value=this.rawToken
          placeholder='Enter ScienceBase token'
        }}
        <button
          type='button'
          class='btn btn-lg btn-primary add-token-button'
          disabled={{if this.rawToken false true}}
          {{on 'click' this.addToken}}
        >
          Add token
        </button>
      {{/if}}
    </div>
  </div>
</div>