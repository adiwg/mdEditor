<div class='form'>
  {{input/md-input
    label='Default Parent Identifier'
    model=this.model
    valuePath='sb-defaultParent'
    placeholder='Enter the identifier for the default Parent item.'
    change=this.save
  }}
  {{input/md-input
    label='Publisher Endpoint'
    model=this.model
    valuePath='publisherEndpoint'
    placeholder='Enter the main endpoint URL for the ScienceBase publisher.'
    change=this.save
  }}
